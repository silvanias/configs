# Optional / heavy packages. Not installed by bootstrap-macos.sh.
# Install when you actually need them:
#   brew bundle --file Brewfile.extras
# Refresh from current machine:
#   brew bundle dump --force --file Brewfile.extras

tap "mongodb/brew"
tap "snyk/tap"

# --- Languages / runtimes ---
brew "n"            # node version manager
brew "yarn"
brew "virtualenv"
brew "openjdk"
brew "llvm"         # large
brew "mingw-w64"    # windows cross-compile

# --- CLI tools ---
brew "awscli"
brew "hugo"
brew "nmap"
brew "ncdu"
brew "inetutils"
brew "sshuttle"
brew "trash"
brew "yt-dlp"
brew "graphviz"
brew "pkgconf"

# --- Databases ---
brew "mysql"
brew "postgresql@17", link: true
brew "influxdb-cli"
brew "mongodb/brew/mongodb-database-tools"

# --- Media / image processing ---
brew "ffmpeg"
brew "imagemagick"
brew "poppler"
brew "ghostscript"
brew "jpeg-xl"
brew "aom"
brew "libavif"
brew "libheif"
brew "gdk-pixbuf"
brew "librsvg"
brew "harfbuzz"
brew "pango"
brew "glib"

# --- Graphics / gamedev ---
brew "glew"
brew "glfw"
brew "glslang"

# --- LaTeX ---
brew "texlive"      # very large (multiple GB)
brew "bib-tool"

# --- Security / containers ---
brew "docker"
brew "cryptography"
brew "snyk/tap/snyk"

# --- GUI apps ---
cask "katrain"
cask "pgadmin4"
cask "whisky"
cask "xquartz"

# --- VS Code / Cursor extensions (require the `code` CLI) ---
vscode "alexcvzz.vscode-sqlite"
vscode "atomiks.moonlight"
vscode "bierner.markdown-preview-github-styles"
vscode "dtoplak.vscode-glsllint"
vscode "eamodio.gitlens"
vscode "esbenp.prettier-vscode"
vscode "github.copilot-chat"
vscode "github.copilot-labs"
vscode "gitpod.gitpod-desktop"
vscode "james-yu.latex-workshop"
vscode "jebbs.plantuml"
vscode "llvm-vs-code-extensions.vscode-clangd"
vscode "lzm0x219.vscode-markdown-github"
vscode "ms-dotnettools.csharp"
vscode "ms-dotnettools.vscode-dotnet-runtime"
vscode "ms-python.black-formatter"
vscode "ms-python.debugpy"
vscode "ms-python.isort"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "ms-toolsai.jupyter"
vscode "ms-toolsai.jupyter-keymap"
vscode "ms-toolsai.jupyter-renderers"
vscode "ms-toolsai.vscode-jupyter-cell-tags"
vscode "ms-toolsai.vscode-jupyter-slideshow"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-vscode-remote.remote-ssh-edit"
vscode "ms-vscode.cmake-tools"
vscode "ms-vscode.cpptools"
vscode "ms-vscode.cpptools-extension-pack"
vscode "ms-vscode.cpptools-themes"
vscode "ms-vscode.remote-explorer"
vscode "ms-vsliveshare.vsliveshare"
vscode "mtxr.sqltools"
vscode "mtxr.sqltools-driver-pg"
vscode "redhat.java"
vscode "ritwickdey.liveserver"
vscode "slevesque.shader"
vscode "sonarsource.sonarlint-vscode"
vscode "twxs.cmake"
vscode "vadimcn.vscode-lldb"
vscode "vintharas.learn-vim"
vscode "visualstudioexptteam.intellicode-api-usage-examples"
vscode "visualstudioexptteam.vscodeintellicode"
vscode "vscjava.vscode-gradle"
vscode "vscjava.vscode-java-debug"
vscode "vscjava.vscode-java-dependency"
vscode "vscjava.vscode-java-pack"
vscode "vscjava.vscode-java-test"
vscode "vscjava.vscode-maven"
vscode "vscode-icons-team.vscode-icons"
vscode "vscodevim.vim"

# --- Cargo ---
cargo "code2prompt"
