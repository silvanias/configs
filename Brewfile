# Minimal core: tools the dotfiles assume + basic dev essentials.
# Heavy / optional packages live in Brewfile.extras.
#   brew bundle --file Brewfile          # this file (core)
#   brew bundle --file Brewfile.extras   # optional extras

# Version control
brew "git"
brew "git-lfs"
brew "gh"

# Editor / terminal / prompt
brew "neovim"
brew "tmux"
brew "stow"
brew "starship"

# Shell utilities referenced by .zshrc / aliases
brew "eza"        # ls replacement (aliased in .zshrc)
brew "fastfetch"  # shown on shell start outside tmux
brew "btop"       # `top` alias
brew "ripgrep"
brew "jq"
brew "tree"
brew "wget"

# Build basics
brew "cmake"
brew "ninja"

# Fonts (Nerd Font for prompt icons)
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
